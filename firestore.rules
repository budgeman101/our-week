rules_version = '2';

// Firestore security rules — this is what actually protects your data.
//
// Paste this into Firebase console -> Firestore Database -> Rules, replacing
// the two placeholder emails with the Google accounts you and your wife use.
// Keep the real emails in the console only (not in this file) if your GitHub
// repo is public and you'd rather not publish them.

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null
        && request.auth.token.email in [
          'YOUR-EMAIL@gmail.com',
          'YOUR-WIFES-EMAIL@gmail.com'
        ];
    }
  }
}
