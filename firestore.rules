rules_version = '2';

// Firestore security rules.
//
// Paste this into Firebase console -> Firestore Database -> Rules.
//
// Only documents under households/<code>/tasks are reachable, and only by
// someone who knows the household code, because the code is part of the
// path. The code is a long random string that never appears in this repo —
// treat it like a house key and only share it with each other.

service cloud.firestore {
  match /databases/{database}/documents {
    match /households/{household}/tasks/{task} {
      allow read, write: if true;
    }
  }
}
